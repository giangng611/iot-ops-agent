{
  "version": "grafana-kpi-rules-v1",
  "source": "bo_chi_so_giam_sat_iot_platform_grafana.xlsx",
  "notes": [
    "Initial machine-readable subset of the KPI workbook.",
    "Thresholds are starting points and should be calibrated after production baseline collection."
  ],
  "rules": [
    {
      "kpi": "API Success Rate",
      "aspect": "Availability",
      "priority": "Core",
      "tool": "grafana_http_health",
      "good": ">= 99.5%",
      "warning": "98% - < 99.5%",
      "critical": "< 98%",
      "status": "OK"
    },
    {
      "kpi": "Broker Availability",
      "aspect": "Availability",
      "priority": "Core",
      "tool": "grafana_emqx_health",
      "good": ">= 99.9%",
      "warning": "99% - < 99.9%",
      "critical": "< 99%",
      "status": "not_done"
    },
    {
      "kpi": "Telemetry Throughput",
      "aspect": "Ingestion",
      "priority": "Core",
      "tool": "grafana_throughput",
      "good": "within designed and stable capacity range",
      "warning": "near 80% of designed capacity",
      "critical": "> 90% of designed capacity or highly volatile",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "Queue Backlog",
      "aspect": "Ingestion",
      "priority": "Core",
      "tool": "grafana_queue_backlog",
      "good": "near zero or short-lived spikes",
      "warning": "increasing but drains within 5-15 minutes",
      "critical": "continuously increasing and not draining",
      "status": "dashboarded"
    },
    {
      "kpi": "API Latency P95",
      "aspect": "API & Application",
      "priority": "Core",
      "tool": "grafana_trace_metrics",
      "good": "<= 1000ms",
      "warning": "> 1000ms to 3000ms",
      "critical": "> 3000ms",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "HTTP 5xx Rate",
      "aspect": "API & Application",
      "priority": "Core",
      "tool": "grafana_http_health",
      "good": "< 0.5%",
      "warning": "0.5% - 2%",
      "critical": "> 2%",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "Session Drop Rate",
      "aspect": "Connectivity",
      "priority": "Diagnostic",
      "tool": "grafana_emqx_health",
      "good": "< 1%",
      "warning": "1% - 3%",
      "critical": "> 3%",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "Reconnect Rate",
      "aspect": "Connectivity",
      "priority": "Diagnostic",
      "tool": "grafana_emqx_health",
      "good": "<= 1",
      "warning": "> 1 to 3",
      "critical": "> 3",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "CPU Utilization",
      "aspect": "Infrastructure",
      "priority": "Diagnostic",
      "tool": "grafana_k8s_health",
      "good": "< 70%",
      "warning": "70% - 85%",
      "critical": "> 85% sustained",
      "status": "dashboarded"
    },
    {
      "kpi": "Memory Utilization",
      "aspect": "Infrastructure",
      "priority": "Diagnostic",
      "tool": "grafana_k8s_health",
      "good": "< 75%",
      "warning": "75% - 90%",
      "critical": "> 90% sustained",
      "status": "dashboarded"
    },
    {
      "kpi": "Disk Usage",
      "aspect": "Infrastructure",
      "priority": "Diagnostic",
      "tool": "grafana_linux_health",
      "good": "< 75%",
      "warning": "75% - 90%",
      "critical": "> 90% sustained",
      "status": "dashboarded"
    },
    {
      "kpi": "Pod/Container Restart Count",
      "aspect": "Infrastructure",
      "priority": "Diagnostic",
      "tool": "grafana_k8s_health",
      "good": "0 or stable baseline",
      "warning": "above baseline or recurring restarts",
      "critical": "continuous restart loop or service impact",
      "status": "available_not_dashboarded"
    }
  ]
}
