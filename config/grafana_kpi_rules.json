{
  "version": "grafana-kpi-rules-v1",
  "source": "bo_chi_so_giam_sat_iot_platform_grafana.xlsx",
  "notes": [
    "Initial machine-readable subset of the KPI workbook.",
    "Thresholds are starting points and should be calibrated after production baseline collection."
  ],
  "rules": [
    {
      "kpi": "API Success Rate",
      "aspect": "Availability",
      "priority": "Core",
      "tool": "grafana_http_health",
      "good": ">= 99.5%",
      "warning": "98% - < 99.5%",
      "critical": "< 98%",
      "status": "OK"
    },
    {
      "kpi": "Broker Availability",
      "aspect": "Availability",
      "priority": "Core",
      "tool": "grafana_emqx_health",
      "good": ">= 99.9%",
      "warning": "99% - < 99.9%",
      "critical": "< 99%",
      "status": "not_done"
    },
    {
      "kpi": "Telemetry Throughput",
      "aspect": "Ingestion",
      "priority": "Core",
      "tool": "grafana_throughput",
      "good": "within designed and stable capacity range",
      "warning": "near 80% of designed capacity",
      "critical": "> 90% of designed capacity or highly volatile",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "Queue Backlog",
      "aspect": "Ingestion",
      "priority": "Core",
      "tool": "grafana_queue_backlog",
      "good": "near zero or short-lived spikes",
      "warning": "increasing but drains within 5-15 minutes",
      "critical": "continuously increasing and not draining",
      "status": "dashboarded"
    },
    {
      "kpi": "API Latency P95",
      "aspect": "API & Application",
      "priority": "Core",
      "tool": "grafana_trace_metrics",
      "good": "<= target p95 latency",
      "warning": "above target but below critical threshold",
      "critical": "sustained p95 latency breach",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "HTTP 5xx Rate",
      "aspect": "API & Application",
      "priority": "Core",
      "tool": "grafana_http_health",
      "good": "near zero",
      "warning": "elevated but limited 5xx rate",
      "critical": "sustained high 5xx rate",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "Session Drop Rate",
      "aspect": "Connectivity",
      "priority": "Diagnostic",
      "tool": "grafana_emqx_health",
      "good": "< 1%",
      "warning": "1% - 3%",
      "critical": "> 3%",
      "status": "available_not_dashboarded"
    },
    {
      "kpi": "Reconnect Rate",
      "aspect": "Connectivity",
      "priority": "Diagnostic",
      "tool": "grafana_emqx_health",
      "good": "<= 1",
      "warning": "> 1 to 3",
      "critical": "> 3",
      "status": "available_not_dashboarded"
    }
  ]
}
