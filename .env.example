# ==============================================================================
# IoT Ops Agent environment template
# Copy this file to `.env`, then fill secrets/URLs for the environment you run.
# Keep real secrets out of git.
# ==============================================================================


# ------------------------------------------------------------------------------
# Core app and security
# ------------------------------------------------------------------------------
FLASK_SECRET_KEY=your_flask_secret_key_here
APP_TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_BASE_URL=https://iot-ops-agent.onrender.com
ACCESS_CODE=please_contact_project_owner

# Browser/UI realtime behavior.
SOCKETIO_CORS_ORIGINS=
TELEMETRY_BROADCAST_INTERVAL_SECONDS=300
ENABLE_EMBEDDED_TELEMETRY=true

# Diagnose/login abuse limits.
MAX_DIAGNOSE_MESSAGE_CHARS=2000
DIAGNOSE_RATE_LIMIT_REQUESTS=10
DIAGNOSE_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300


# ------------------------------------------------------------------------------
# API keys and LLM providers
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_new_key_here


# ------------------------------------------------------------------------------
# Primary app database: Supabase/Postgres
# ------------------------------------------------------------------------------
# APP_DB_BACKEND should be `supabase` for shared/team environments.
# Keep APP_DB_FALLBACK_ENABLED=false when you want failures to surface instead of
# silently falling back to local SQLite.
APP_DB_BACKEND=supabase
APP_DB_FALLBACK_ENABLED=false
SUPABASE_DB_URL=postgresql://postgres.project-ref:[YOUR-PASSWORD]@region.pooler.supabase.com:6543/postgres

# Postgres connection pool and safety timeouts.
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_STATEMENT_TIMEOUT_MS=4000
POSTGRES_LOCK_TIMEOUT_MS=3000
POSTGRES_CIRCUIT_BREAKER_SECONDS=30


# ------------------------------------------------------------------------------
# Local/runtime telemetry storage: MongoDB
# ------------------------------------------------------------------------------
# These settings are for the app-owned MongoDB telemetry store, not the company DB.
# Set ENABLE_MONGODB=true when local Mongo telemetry is available.
# READ_TELEMETRY_FROM_MONGO controls reads; TELEMETRY_WRITE_BACKEND controls writes.
ENABLE_MONGODB=false
READ_TELEMETRY_FROM_MONGO=false
TELEMETRY_WRITE_BACKEND=sqlite
MONGODB_URI=mongodb://iot_ops_runtime:[PASSWORD]@localhost:27017/iot_ops_agent?authSource=iot_ops_agent
MONGODB_ADMIN_URI=mongodb://iot_ops_admin:[PASSWORD]@localhost:27017/admin?authSource=admin
MONGODB_DB=iot_ops_agent
MONGODB_TELEMETRY_COLLECTION=telemetry
MONGO_READ_RATE_LIMIT_REQUESTS=60
MONGO_READ_RATE_LIMIT_WINDOW_SECONDS=60


# ------------------------------------------------------------------------------
# Company database source: Postgres and MongoDB
# ------------------------------------------------------------------------------
# COMPANY_DB_URL is the optional company Postgres read source.
COMPANY_DB_URL=postgresql://readonly_user:[PASSWORD]@company-db-host:5432/company_db

# COMPANY_MONGODB_* is the company MongoDB read source used for real inventory,
# telemetry, KPI evidence, and rule discovery.
# Single-host company MongoDB deployments often advertise private replica-set
# members; directConnection=true keeps the read proxy on the configured host.
COMPANY_MONGODB_URI=mongodb://readonly_user:[PASSWORD]@company-mongo-host:27017/?authSource=admin&directConnection=true
COMPANY_MONGODB_DB=
COMPANY_MONGO_ALLOWED_NAMESPACES=devicemgmt.NODE,authorization.IDENTITY,datamgmt.CNT,datamgmt.CIN,datamgmt.DEVICE_TELEMETRY,datamgmt.RULE

# Company DB guardrails.
COMPANY_DB_CONNECT_TIMEOUT_SECONDS=5
COMPANY_DB_STATEMENT_TIMEOUT_MS=5000
COMPANY_MONGO_PROXY_RATE_LIMIT_REQUESTS=120
COMPANY_MONGO_PROXY_RATE_LIMIT_WINDOW_SECONDS=60


# ------------------------------------------------------------------------------
# Telegram bot integration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret_here
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_UPDATE_RETENTION_SECONDS=86400
TELEGRAM_LINK_CODE_TTL_MINUTES=15


# ------------------------------------------------------------------------------
# n8n workflows
# ------------------------------------------------------------------------------
# Legacy evaluator workflow.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/iot-ops-eval

# IOA v3 Grafana Ops Gateway workflow.
N8N_V3_WEBHOOK_URL=http://localhost:5679/webhook/grafana-ops-gateway


# ------------------------------------------------------------------------------
# Dify chat app
# ------------------------------------------------------------------------------
DIFY_API_URL=http://localhost/v1/chat-messages
DIFY_API_KEY=your_dify_app_api_key_here
DIFY_USER=iot-ops-agent-ui


# ------------------------------------------------------------------------------
# Grafana / IOA v3 workflow adapter
# ------------------------------------------------------------------------------
GRAFANA_DASHBOARD_CLIENT_URL=http://127.0.0.1:5050
IOA_V3_ENABLE_KPI_RULES=false
