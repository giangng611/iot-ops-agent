# ==============================================================================
# IoT Ops Agent environment template
# Same variable set/order as .env; values are placeholders only.
# Real company MongoDB/Grafana/Loki credentials belong in mcp_server/.env.
# ==============================================================================

# Core app and security
FLASK_SECRET_KEY=replace_me
APP_TIMEZONE=
PUBLIC_BASE_URL=
ACCESS_CODE=replace_me
SOCKETIO_CORS_ORIGINS=
TELEMETRY_BROADCAST_INTERVAL_SECONDS=0
ENABLE_EMBEDDED_TELEMETRY=false
MAX_DIAGNOSE_MESSAGE_CHARS=0
DIAGNOSE_RATE_LIMIT_REQUESTS=
DIAGNOSE_RATE_LIMIT_WINDOW_SECONDS=0
LOGIN_RATE_LIMIT_ATTEMPTS=0
LOGIN_RATE_LIMIT_WINDOW_SECONDS=0

# API keys and LLM providers
OPENAI_API_KEY=replace_me

# Primary app database / app-owned storage
APP_DB_BACKEND=supabase
APP_DB_FALLBACK_ENABLED=false
SUPABASE_DB_URL=replace_me
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=1
POSTGRES_POOL_TIMEOUT_SECONDS=0
POSTGRES_CONNECT_TIMEOUT_SECONDS=0
POSTGRES_STATEMENT_TIMEOUT_MS=
POSTGRES_LOCK_TIMEOUT_MS=
POSTGRES_CIRCUIT_BREAKER_SECONDS=0
ENABLE_MONGODB=false
READ_TELEMETRY_FROM_MONGO=false
TELEMETRY_WRITE_BACKEND=sqlite
MONGODB_URI=
MONGODB_ADMIN_URI=
MONGODB_DB=
MONGODB_TELEMETRY_COLLECTION=
MONGO_READ_RATE_LIMIT_REQUESTS=
MONGO_READ_RATE_LIMIT_WINDOW_SECONDS=0
COMPANY_MONGODB_URI=
COMPANY_MONGODB_DB=
COMPANY_DB_CONNECT_TIMEOUT_SECONDS=0
COMPANY_DB_STATEMENT_TIMEOUT_MS=

# Telegram bot integration
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_me
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_HISTORY_USER_ID=
TELEGRAM_DEFAULT_DATA_SOURCE=
TELEGRAM_LINK_CODE_TTL_MINUTES=0

# n8n workflows
N8N_WEBHOOK_URL=
N8N_V3_WEBHOOK_URL=

# Dify chat app
DIFY_API_URL=
DIFY_API_KEY=replace_me
DIFY_USER=replace_me

# Observability adapter
GRAFANA_TOOL_ACCESS_MODE=n8n
GRAFANA_DASHBOARD_CLIENT_URL=
IOA_V3_ENABLE_KPI_RULES=

# Company operational access: app is MCP client only
COMPANY_DATA_ACCESS_MODE=mcp
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_BEARER_KEY=replace_me
COMPANY_DB_URL=
